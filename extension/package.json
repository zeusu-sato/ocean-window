{
  "name": "ocean-window",
  "displayName": "Ocean Window",
  "description": "%extension.description%",
  "version": "0.3.0",
  "publisher": "zeusu-sato",
  "repository": { "type": "git", "url": "https://github.com/zeusu-sato/ocean-window.git" },
  "homepage": "https://github.com/zeusu-sato/ocean-window#readme",
  "bugs": { "url": "https://github.com/zeusu-sato/ocean-window/issues" },
  "license": "MIT",
  "engines": { "vscode": "^1.130.0" },
  "categories": ["Other"],
  "keywords": ["ocean", "sea", "wallpaper", "background", "empty editor", "scenery"],
  "preview": true,
  "icon": "icon.png",
  "galleryBanner": { "color": "#060621", "theme": "dark" },
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.cjs",
  "scripts": { "vscode:uninstall": "node ./out/uninstall.cjs" },
  "capabilities": { "untrustedWorkspaces": { "supported": true }, "virtualWorkspaces": { "supported": true } },
  "contributes": {
    "commands": [
      { "command": "oceanWindow.enable", "title": "%command.enable%", "category": "Ocean Window" },
      { "command": "oceanWindow.disable", "title": "%command.disable%", "category": "Ocean Window" },
      { "command": "oceanWindow.restoreLegacy", "title": "%command.restoreLegacy%", "category": "Ocean Window" },
      { "command": "oceanWindow.status", "title": "%command.status%", "category": "Ocean Window" },
      { "command": "oceanWindow.openSettings", "title": "%command.settings%", "category": "Ocean Window" },
      { "command": "oceanWindow.openGuide", "title": "%command.guide%", "category": "Ocean Window" }
    ],
    "configuration": {
      "title": "Ocean Window",
      "properties": {
        "oceanWindow.intervalMinutes": { "type": "number", "default": 10, "minimum": 1, "maximum": 1440, "scope": "window", "description": "%setting.interval%" },
        "oceanWindow.brightness": { "type": "number", "default": 0.78, "minimum": 0, "maximum": 1, "scope": "window", "description": "%setting.brightness%" },
        "oceanWindow.showCaption": { "type": "boolean", "default": true, "scope": "window", "description": "%setting.caption%" },
        "oceanWindow.refreshHours": { "type": "number", "default": 24, "minimum": 1, "maximum": 168, "scope": "window", "description": "%setting.refresh%" },
        "oceanWindow.targetPhotoCount": { "type": "integer", "default": 60, "minimum": 1, "maximum": 200, "scope": "window", "description": "%setting.count%" }
      }
    }
  }
}
